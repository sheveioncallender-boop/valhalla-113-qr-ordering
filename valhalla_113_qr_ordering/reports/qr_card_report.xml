<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_valhalla_qr_cards" model="report.paperformat">
        <field name="name">Valhalla QR Table Cards</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_valhalla_qr_cards" model="ir.actions.report">
        <field name="name">Valhalla Table QR Cards</field>
        <field name="model">valhalla.qr.print.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">valhalla_113_qr_ordering.report_valhalla_qr_cards</field>
        <field name="report_file">valhalla_113_qr_ordering.report_valhalla_qr_cards</field>
        <field name="paperformat_id" ref="paperformat_valhalla_qr_cards"/>
        <field name="print_report_name">'Valhalla 113 Table QR Cards'</field>
    </record>

    <template id="report_valhalla_qr_cards">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="cards" t-value="wizard._get_report_cards()"/>
                <t t-call="web.basic_layout">
                    <style>
                        @page { margin: 5mm; }
                        .vh-page { width: 100%; font-family: Arial, Helvetica, sans-serif; }
                        .vh-card {
                            position: relative;
                            overflow: hidden;
                            box-sizing: border-box;
                            background: #080808;
                            color: #f5f5f5;
                            border: 2px solid #d71920;
                            border-radius: 10px;
                            text-align: center;
                            page-break-inside: avoid;
                        }
                        .vh-four {
                            display: inline-block;
                            vertical-align: top;
                            width: 48%;
                            min-height: 132mm;
                            margin: 1% 0.75%;
                            padding: 7mm 7mm 6mm;
                        }
                        .vh-single {
                            width: 190mm;
                            min-height: 275mm;
                            margin: 0 auto;
                            padding: 18mm 18mm 12mm;
                            page-break-after: always;
                        }
                        .vh-single:last-child { page-break-after: auto; }
                        .vh-stripe { position:absolute; top:0; left:0; right:0; height:5px; background:#d71920; }
                        .vh-logo { object-fit: contain; display:block; margin:0 auto 2mm; }
                        .vh-four .vh-logo { width: 42mm; height: 33mm; }
                        .vh-single .vh-logo { width: 80mm; height: 63mm; }
                        .vh-heading { margin: 1mm 0 1mm; font-weight: 800; letter-spacing: 1.5px; color:#ffffff; }
                        .vh-four .vh-heading { font-size: 15px; }
                        .vh-single .vh-heading { font-size: 28px; letter-spacing: 3px; }
                        .vh-floor { color:#aeb3b8; text-transform:uppercase; letter-spacing:1.2px; margin-top:1mm; }
                        .vh-table { font-weight:900; color:#ffffff; text-transform:uppercase; line-height:1; }
                        .vh-four .vh-table { font-size: 25px; margin:2mm 0 1mm; }
                        .vh-single .vh-table { font-size: 48px; margin:5mm 0 2mm; }
                        .vh-qr-shell { display:inline-block; background:#ffffff; padding:3mm; border-radius:7px; border:2px solid #d9d9d9; }
                        .vh-four .vh-qr { width:55mm; height:55mm; }
                        .vh-single .vh-qr { width:105mm; height:105mm; }
                        .vh-instruction { color:#ededed; line-height:1.35; margin:3mm auto 0; }
                        .vh-four .vh-instruction { font-size:12px; max-width:72mm; }
                        .vh-single .vh-instruction { font-size:22px; max-width:145mm; }
                        .vh-footer { margin-top:3mm; color:#d71920; font-weight:700; letter-spacing:.5px; }
                        .vh-four .vh-footer { font-size:10px; }
                        .vh-single .vh-footer { font-size:17px; }
                        .vh-url { margin-top:2mm; color:#92979c; word-break:break-all; }
                        .vh-four .vh-url { font-size:6px; }
                        .vh-single .vh-url { font-size:9px; }
                        .vh-metal { height:1px; margin:3mm 0; background:linear-gradient(90deg, transparent, #c7c9ca, transparent); }
                    </style>
                    <div class="vh-page">
                        <t t-foreach="cards" t-as="card">
                            <div t-attf-class="vh-card #{'vh-single' if wizard.layout == 'single' else 'vh-four'}">
                                <div class="vh-stripe"/>
                                <img class="vh-logo" src="/valhalla_113_qr_ordering/static/src/img/valhalla_logo.png" alt="Valhalla 113 Bar &amp; Grill"/>
                                <div class="vh-heading" t-esc="wizard.heading"/>
                                <div class="vh-metal"/>
                                <div class="vh-floor" t-esc="card['floor_name']"/>
                                <div class="vh-table" t-esc="card['table_label']"/>
                                <div class="vh-qr-shell">
                                    <img class="vh-qr"
                                         t-att-src="'/report/barcode/QR/%s?width=600&amp;height=600&amp;barLevel=H' % card['url']"
                                         alt="Table QR Code"/>
                                </div>
                                <div class="vh-instruction" t-esc="wizard.instruction"/>
                                <div class="vh-footer" t-if="wizard.footer_text" t-esc="wizard.footer_text"/>
                                <div class="vh-url" t-if="wizard.show_url" t-esc="card['url']"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
