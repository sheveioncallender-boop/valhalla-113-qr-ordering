<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_valhalla_qr" model="ir.ui.view">
        <field name="name">pos.config.form.valhalla.qr</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Valhalla QR Ordering" name="valhalla_qr_ordering">
                    <div class="alert alert-warning" role="alert" invisible="module_pos_restaurant">
                        This Point of Sale is not yet configured as a restaurant. The setup button below will enable Odoo Restaurant mode.
                    </div>
                    <div class="alert alert-info" role="alert">
                        <strong>Native Odoo flow, Valhalla presentation.</strong>
                        Each QR code securely identifies the POS configuration and the selected restaurant table.
                    </div>
                    <group>
                        <group string="Native Self-Ordering Setup">
                            <field name="self_ordering_mode" readonly="has_active_session"/>
                            <field name="self_ordering_service_mode" readonly="has_active_session"/>
                            <field name="self_ordering_pay_after" readonly="has_active_session"/>
                            <field name="self_ordering_image_brand" widget="image" class="oe_avatar" readonly="has_active_session"/>
                            <field name="self_ordering_image_brand_name" readonly="has_active_session"/>
                        </group>
                        <group string="Printed Table Cards">
                            <field name="valhalla_qr_heading"/>
                            <field name="valhalla_qr_instruction"/>
                            <field name="valhalla_qr_footer"/>
                            <field name="valhalla_qr_show_url"/>
                        </group>
                    </group>
                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <button name="action_apply_valhalla_qr_setup"
                                type="object"
                                string="Apply Valhalla QR Setup"
                                class="btn-primary"
                                icon="fa-qrcode"
                                groups="point_of_sale.group_pos_manager"
                                invisible="has_active_session"/>
                        <button name="action_open_valhalla_qr_wizard"
                                type="object"
                                string="Print Table QR Cards"
                                class="btn-secondary"
                                icon="fa-print"/>
                        <button name="preview_self_order_app"
                                type="object"
                                string="Preview Self-Order Menu"
                                class="btn-secondary"
                                icon="fa-external-link"
                                invisible="self_ordering_mode == 'nothing'"/>
                    </div>
                    <div class="alert alert-warning mt-3" role="alert" invisible="not has_active_session">
                        Close the active POS session before changing restaurant or self-ordering settings.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
